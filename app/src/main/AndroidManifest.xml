<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Faucet backend is a public HTTPS endpoint, called directly (no node HTTP proxy) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility: needed to launch the node app and to deliver
         our targeted (setPackage) IPC broadcasts to it -->
    <queries>
        <package android:name="org.minimarex.minimacore" />
    </queries>

    <!-- allowBackup=false: the whole apks/ fleet was scaffolded with allowBackup="true" and empty backup
         rules, so Android Auto Backup uploaded each app's entire data directory to the user's cloud and
         restored it on reinstall. Harmless-looking apps still carried the node pairing token, and a
         reinstall must be a true reset everywhere, not just in the apps holding keys.
         At stake here: nothing of its own — it persists no prefs, no database and no files. The shared minima_api_prefs node
         pairing token was the only thing being carried, and a restored token is stale by definition -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Faucet"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
